<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="FarmConnect E2E Test Automation Suite" parallel="none" verbose="2">

    <listeners>
        <listener class-name="com.farmconnect.automation.listeners.TestListener"/>
        <listener class-name="com.farmconnect.automation.listeners.ExtentReportListener"/>
        <listener class-name="com.farmconnect.automation.listeners.ScreenshotListener"/>
    </listeners>

    <test name="Authentication Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.auth.LoginTests"/>
            <class name="com.farmconnect.automation.tests.auth.LoginAdvancedTests"/>
        </classes>
    </test>

    <test name="Authorization Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.authorization.AuthorizationTests"/>
        </classes>
    </test>

    <test name="Registration Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.registration.RegistrationTests"/>
        </classes>
    </test>

    <test name="Profile Management Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.profile.ProfileManagementTests"/>
        </classes>
    </test>

    <test name="Navigation Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.navigation.NavigationTests"/>
        </classes>
    </test>

    <test name="Dashboard Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.dashboard.DashboardTests"/>
        </classes>
    </test>

    <test name="Forms Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.forms.FormTests"/>
            <class name="com.farmconnect.automation.tests.forms.FormAdvancedTests"/>
        </classes>
    </test>

    <test name="CRUD Operations Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.crud.CrudOperationsTests"/>
            <class name="com.farmconnect.automation.tests.crud.CrudAdvancedTests"/>
        </classes>
    </test>

    <test name="Search Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.search.SearchTests"/>
        </classes>
    </test>

    <test name="Filter Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.filters.FilterTests"/>
        </classes>
    </test>

    <test name="Input Validation Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.validation.InputValidationTests"/>
            <class name="com.farmconnect.automation.tests.validation.InputValidationAdvTests"/>
        </classes>
    </test>

    <test name="Error Handling Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.errorhandling.ErrorHandlingTests"/>
        </classes>
    </test>

    <test name="Session Management Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.session.SessionManagementTests"/>
        </classes>
    </test>

    <test name="Notification Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.notifications.NotificationTests"/>
        </classes>
    </test>

    <test name="File Upload Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.fileupload.FileUploadTests"/>
        </classes>
    </test>

    <test name="Offline Handling Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.offline.OfflineHandlingTests"/>
        </classes>
    </test>

    <test name="Accessibility Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.accessibility.AccessibilityTests"/>
        </classes>
    </test>

    <test name="Responsive UI Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.responsive.ResponsiveUITests"/>
        </classes>
    </test>

    <test name="Performance Smoke Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.performance.PerformanceSmokeTests"/>
        </classes>
    </test>

    <test name="Regression Suite Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.regression.RegressionSuiteTests"/>
            <class name="com.farmconnect.automation.tests.regression.RegressionSuiteAdvTests"/>
        </classes>
    </test>

</suite>

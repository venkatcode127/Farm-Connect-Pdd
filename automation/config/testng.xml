<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="FarmConnect AI - E2E Automation Suite" verbose="2" parallel="none" thread-count="1">

    <listeners>
        <listener class-name="com.farmconnect.automation.listeners.TestListener"/>
        <listener class-name="com.farmconnect.automation.listeners.ExtentReportListener"/>
        <listener class-name="com.farmconnect.automation.listeners.ScreenshotListener"/>
    </listeners>

    <!-- ==================== AUTHENTICATION MODULE ==================== -->
    <test name="Authentication Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.auth.LoginTests"/>
            <class name="com.farmconnect.automation.tests.auth.LoginAdvancedTests"/>
        </classes>
    </test>

    <!-- ==================== AUTHORIZATION MODULE ==================== -->
    <test name="Authorization Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.authorization.AuthorizationTests"/>
        </classes>
    </test>

    <!-- ==================== REGISTRATION MODULE ==================== -->
    <test name="Registration Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.registration.RegistrationTests"/>
        </classes>
    </test>

    <!-- ==================== PROFILE MANAGEMENT MODULE ==================== -->
    <test name="Profile Management Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.profile.ProfileManagementTests"/>
        </classes>
    </test>

    <!-- ==================== NAVIGATION MODULE ==================== -->
    <test name="Navigation Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.navigation.NavigationTests"/>
        </classes>
    </test>

    <!-- ==================== DASHBOARD MODULE ==================== -->

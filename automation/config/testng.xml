    </test>

    <!-- ==================== CRUD OPERATIONS MODULE ==================== -->
    <test name="CRUD Operations Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.crud.CrudOperationsTests"/>
            <class name="com.farmconnect.automation.tests.crud.CrudAdvancedTests"/>
        </classes>
    </test>

    <!-- ==================== SEARCH MODULE ==================== -->
    <test name="Search Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.search.SearchTests"/>
        </classes>
    </test>

    <!-- ==================== FILTERS MODULE ==================== -->
    <test name="Filters Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.filters.FilterTests"/>

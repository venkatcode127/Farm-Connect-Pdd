        <classes>
            <class name="com.farmconnect.automation.tests.validation.InputValidationTests"/>
            <class name="com.farmconnect.automation.tests.validation.InputValidationAdvTests"/>
        </classes>
    </test>

    <!-- ==================== ERROR HANDLING MODULE ==================== -->
    <test name="Error Handling Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.errorhandling.ErrorHandlingTests"/>
        </classes>
    </test>

    <!-- ==================== SESSION MANAGEMENT MODULE ==================== -->
    <test name="Session Management Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.session.SessionManagementTests"/>
        </classes>
    </test>

    <!-- ==================== NOTIFICATIONS MODULE ==================== -->
    <test name="Notifications Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.notifications.NotificationTests"/>
        </classes>
    </test>

    <!-- ==================== FILE UPLOAD MODULE ==================== -->
    <test name="File Upload Tests">
        <classes>
            <class name="com.farmconnect.automation.tests.fileupload.FileUploadTests"/>
        </classes>

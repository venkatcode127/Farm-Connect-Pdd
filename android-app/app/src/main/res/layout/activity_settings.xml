<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/background_mint">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Server Connection Settings"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your Computer's IPv4 address here to connect the app on any network."
        android:layout_marginTop="8dp"
        android:textColor="@color/text_muted" />

    <EditText
        android:id="@+id/etServerIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="e.g. 192.168.1.28"
        android:inputType="text"
        android:background="@drawable/bg_input"
        android:padding="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Save &amp; Connect"
        android:textAllCaps="false"
        app:cornerRadius="8dp" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_mint">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Hero Section -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardHero"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/primary"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvHeroTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Smart Farming Starts Here"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvHeroSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="AI-powered price predictions to maximize your profits"
                    android:textColor="#E0F7EF"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvHeroTitle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGetPrediction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Get My AI Prediction"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/white"
                    android:textColor="@color/primary"
                    app:cornerRadius="8dp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvHeroSubtitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Status Cards Grid -->
        <GridLayout
            android:id="@+id/gridStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardHero">

            <!-- Top Gainer -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardTopGainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Top Gainer Today" android:textSize="10sp" android:textColor="@color/text_muted"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Red Chilli ▲ 1.2%" android:textStyle="bold" android:textColor="@color/primary" android:layout_marginTop="2dp" android:textSize="12sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Price Alerts -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPriceAlerts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Price Alerts" android:textSize="10sp" android:textColor="@color/text_muted"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5 Active" android:textStyle="bold" android:textColor="@color/text_dark" android:layout_marginTop="2dp" android:textSize="12sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Active Listings -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardActiveListings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active Listings" android:textSize="10sp" android:textColor="@color/text_muted"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9 Items" android:textStyle="bold" android:textColor="@color/text_dark" android:layout_marginTop="2dp" android:textSize="12sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Markets Tracked -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardMarketsTracked"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Markets Tracked" android:textSize="10sp" android:textColor="@color/text_muted"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10 Mandis" android:textStyle="bold" android:textColor="@color/text_dark" android:layout_marginTop="2dp" android:textSize="12sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </GridLayout>

        <!-- Mandi Selector -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMandi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#EAF7F2"
            app:layout_constraintTop_toBottomOf="@id/gridStatus">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Select Mandi / State:" android:textSize="12sp" android:textColor="@color/text_dark"/>
                <Spinner
                    android:id="@+id/spinnerMandi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Quick Price Overview Table -->
        <TextView
            android:id="@+id/tvTableTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Price Overview"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text_dark"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/cardMandi"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvTableTitle">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Table Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="#FAFAFA">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="CROP" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/text_muted"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:text="PRICE (₹/QT)" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/text_muted" android:gravity="end"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:text="CHANGE 24H" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/text_muted" android:gravity="end"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPriceOverview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

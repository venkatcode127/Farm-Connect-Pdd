<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_mint">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvAiTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI Prediction - Top 3 Crops"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/text_dark"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAiPredictions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvAiTitle" />

        <!-- Mock details for the rest of the prediction logic -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="16dp"
            app:layout_constraintTop_toBottomOf="@id/rvAiPredictions">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#FAFFFD">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Why these predictions?" android:textStyle="bold" android:textColor="@color/primary"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Our AI analyzes 10 years of historical data, current weather patterns, and global market trends to give you the most accurate price forecasts." android:layout_marginTop="8dp" android:textSize="13sp" android:textColor="@color/text_muted"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
